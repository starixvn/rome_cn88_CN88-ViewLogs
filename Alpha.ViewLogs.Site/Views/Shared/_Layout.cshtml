@using Alpha.ViewLogs.Site.Helpers.StaticResources;
@using Alpha.ViewLogs.Site.Configurations;
@using CN88.Web.Helpers;
@model LogViewModel
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    @StaticResources.AssetStyles.RenderCommon("/bundles/common/common")
    @AssetStyles.Render($"/bundles/site-viewlogs/viewlogs")
    <link rel="stylesheet" href="@ViewLogsStyles.GetAbsolutePath("~/assets/bundles/default")" />
    @RenderSection("Styles", required: false)
</head>
<body @(Html.Raw(CN88.Web.Helpers.BrowserManager.BuildMobileHtmlClass()))>
    <div class="container-fluid page-viewlog">
        @Html.Action("Index", "Tab", new { tabName = ViewContext.RouteData.Values["controller"], area = "" })
        @RenderBody()
        @Html.Partial("MonthNames")
    </div>
    @Html.Hidden("indexPath", "/" + AppSettings.VirtualDirectory + ViewContext.RouteData.Values["controller"] + "/index")
    @Html.Hidden("usernameAutoSuggestionPath", Model.UsernameAutoSuggestionPath)
    @Html.Hidden("viewIPInfoPath", Model.ViewIPInfoPath)
    @RenderSection("Scripts", required: false)
    @Html.Raw(Fanex.Logging.LogManager.RenderJavascriptLogger())
    <script>
        var resources = { ipInfo: '@Resources.ipInfo' };
    </script>
    @CN88.Web.Helpers.GoogleAnalyticHepler.Render()
</body>
</html>